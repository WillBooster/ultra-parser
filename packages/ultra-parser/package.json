{
  "name": "ultra-parser",
  "version": "0.0.0",
  "description": "Runtime for parsers that the ultra-parser tool generates from ANTLR grammars, running in WebAssembly.",
  "license": "BSD-3-Clause",
  "author": "WillBooster Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/ultra-parser.git"
  },
  "files": [
    "dist",
    "src",
    "ultra_parser.wasm"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./ultra_parser.wasm": "./ultra_parser.wasm"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "test": "bun wb test",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.4",
    "@willbooster/oxlint-config": "1.4.9",
    "@willbooster/wb": "23.0.1",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005"
  },
  "engines": {
    "node": ">=20.16.0"
  }
}
